# VCS / IDE
.git
.gitignore
.github
.vscode
.idea

# Secrets — dikirim lewat environment compose, jangan di-bake ke image
.env

# Dependency & artefak lokal (composer install dijalankan di dalam image)
vendor
node_modules
.php-cs-fixer.cache

# Artefak lokal: public/vendor/heroic biasanya symlink ke vendor/ (hanya untuk
# dev). Source tidak pernah di-COPY ke image, tapi tetap dikecualikan agar
# context build tidak membawa symlink dangling bila suatu saat source disalin.
public/vendor

# Data runtime (volume docker, bukan bagian context build)
writable

# Test & tooling dev
tests

# OS junk
.DS_Store
