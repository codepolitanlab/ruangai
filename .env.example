# ---------------------------------------------------------------------------
# Environment untuk docker compose (RuangAI)
#
# `docker compose` membaca file `.env` di folder ini untuk interpolasi `${VAR}`
# pada docker-compose.yml. File `.env` yang sama juga dibaca CodeIgniter bila
# dijalankan langsung (tanpa Docker), jadi blok ini aman ditambahkan ke `.env`
# yang sudah ada — jangan menghapus key CI4 (app.baseURL, database.default.*,
# dst.).
#
# Semua nilai di bawah adalah default yang sudah dipakai docker-compose.yml.
# Hapus atau kosongkan baris bila ingin memakai default tersebut.
#
# PENTING: `.env` di root TIDAK di-mount ke container `web` (lihat catatan di
# docker-compose.yml). Konfigurasi container diberikan lewat blok `environment`
# compose, yang mengambil nilai dari variabel-variabel di file ini.
# ---------------------------------------------------------------------------

# --- Aplikasi (CodeIgniter) ---
# development | testing | production
CI_ENVIRONMENT=development
# Port host untuk service `web` (container selalu listen di 8080).
APP_PORT=8887
# Dipakai CodeIgniter sebagai base_url; samakan portnya dengan APP_PORT.
APP_BASE_URL=http://localhost:8887/
APP_INDEX_PAGE=
# true bila aplikasi berada di belakang reverse proxy HTTPS.
APP_FORCE_HTTPS=false
APP_CSP_ENABLED=false
APP_TIMEZONE=Asia/Jakarta

# --- Identitas situs ---
# Dipakai layout (manifest, offline page) dan FormFields Heroic:
# public/uploads/<SITENAME>/... serta kunci filemanager md5(SITENAME . ENC_KEY).
SITENAME=ruangai
ENC_KEY=

# --- Encryption (Config\Encryption::$key) ---
# Ganti dengan string acak 32 byte di production.
ENCRYPTION_KEY=sadfszdvnvbsfdiu34qwu6yethjgq39aw4er

# --- Database (service `db` / MySQL 8.4) ---
# Tiga nilai di bawah juga dipakai sebagai MYSQL_DATABASE / MYSQL_USER /
# MYSQL_PASSWORD saat container `db` pertama kali dibuat. Mengubahnya setelah
# volume `db_data` ada tidak mengubah user/database yang sudah terlanjur dibuat.
DB_DATABASE=app_ruangai
DB_USERNAME=app
DB_PASSWORD="mypass!@#"
# Password user root MySQL (hanya untuk container `db`).
DB_ROOT_PASSWORD=rootsecret
# Port host untuk service `db` (container selalu 3306).
DB_PORT=33199
DB_DRIVER=MySQLi
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_general_ci

# --- Cache & Session (service `redis`) ---
CACHE_HANDLER=redis
CACHE_PREFIX=
# Port host untuk service `redis`. Koneksi dari container `web` selalu memakai
# `redis:6379` (port di dalam network compose), bukan nilai ini.
REDIS_PORT=6378
# Redis di compose ini tanpa password. Bila menambahkan `requirepass`, set juga
# `cache_redis_password` pada docker-compose.yml (lihat komentar di sana).
# REDIS_PASSWORD=
SESSION_DRIVER='CodeIgniter\Session\Handlers\RedisHandler'
SESSION_SAVE_PATH=tcp://redis:6379
SESSION_COOKIE_NAME=ci_session
SESSION_EXPIRATION=7200

# --- Logger ---
# Kosongkan untuk memakai default Config\Logger (4 di production, 9 di development).
# LOG_THRESHOLD=

# --- Email / SMTP (App\Libraries\EmailSender) ---
MAIL_PROTOCOL=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_TIMEOUT=5
MAIL_FROM_ADDRESS=admin@admin.com
MAIL_FROM_NAME=RuangAI

# --- Heroic: JWT, reCAPTCHA, Xendit, SaungWA ---
JWT_SECRET=A8xl9FX2/M77KUnLlrt7mWt4gLFM+6ZbPzG6takiSTU=
RECAPTCHA_SITE_KEY=6LcBlpsrAAAAAD8ar_ALNgvFq_1O00DtpIK2Lll7
RECAPTCHA_SECRET_KEY=6LcBlpsrAAAAALTayxF003EJc8xtAXHFdrn5PwIT
# Aktif/nonaktif reCAPTCHA dihitung dari CI_ENVIRONMENT (aktif selain
# development). Isi true/false hanya bila ingin memaksa.
# RECAPTCHA_ENABLED=
XENDIT_SECRET_KEY=xnd_development_VhoXvOVbaFJVWsYO8LiBq153MGLHjjqIEM7AlPnggwS3AEVUTCL3bMXyS7MoSfz
XENDIT_PUBLIC_KEY=xnd_public_development_StXS_AOkori6nxKP52JTUV5nnx_BVTA1rnteoDhtFIFUPmPVNYEogUyYEAq4xy
XENDIT_CALLBACK_TOKEN=WaJBJ4O3XUtB2izC5FmyAN2mfgouAWEEmgnoo9XQEgKpQffR
