# --- Zoom (Config\Course) ---
ZOOM_ACCOUNT_ID=BX4NjKOmQGSmrNP5sv5DUQ
ZOOM_CLIENT_ID=cKS5Uh1NTnOlZqwAlZHddw
ZOOM_CLIENT_SECRET=6rlnoLL8itrOgn9hAY7zHvTveqg86VBB
# Waktu tunggu tombol "Saya sudah paham" (milidetik).
COURSE_WAIT_UNDERSTAND_MS=60000

# --- CODEPOLITAN Checkout (Config\CPCheckout) ---
CPCHECKOUT_SERVICE_URL=https://payment.test
CPCHECKOUT_CLIENT_CODE=JS
CPCHECKOUT_APP_KEY=

# --- Web Push / VAPID (App\Libraries\WebPush) ---
WEBPUSH_SUBJECT=mailto:contact@codepolitan.com
WEBPUSH_PUBLIC_KEY=BDSkwRKMHK7WT6hTXe7oj0OJ6q9pqIX61tjZc4jR9b7ldszNsmRb1AbAVVFPxUerbhsOaV9Xa-99IEgUHzr2IcM
WEBPUSH_PRIVATE_KEY=DA8Ng4cFIn5W-mI5urQG3rghIziI5Yfh1i1gKzvUkyE

# --- PHP-FPM / Nginx (serversideup/php) ---
# Worker PHP-FPM berjalan dengan UID/GID host agar file yang ditulis aplikasi ke
# source yang di-mount (mis. public/uploads/) tetap milik user host.
# Sesuaikan dengan hasil `id -u` dan `id -g`.
PUID=1000
PGID=1000
# 0 = OPcache nonaktif (cocok untuk development), 1 = aktif (production).
PHP_OPCACHE_ENABLE=0

# --- Migrasi ---
# true  = `php spark migrate --all` dijalankan otomatis saat container start
# false = migrasi manual, mis. `docker compose exec web php spark migrate -n 'Classroom'`
RUN_MIGRATIONS=true
