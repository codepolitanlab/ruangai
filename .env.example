# ---------------------------------------------------------------------------
# Environment untuk docker compose (RuangAI)
#
# `docker compose` membaca file `.env` di folder ini untuk interpolasi `${VAR}`
# pada docker-compose.yml. File `.env` yang sama juga dibaca CodeIgniter, jadi
# blok ini aman ditambahkan ke `.env` yang sudah ada — jangan menghapus key CI4
# (app.baseURL, database.default.*, dst.).
#
# Semua nilai di bawah adalah default yang sudah dipakai docker-compose.yml.
# Hapus atau kosongkan baris bila ingin memakai default tersebut.
# ---------------------------------------------------------------------------

# --- Aplikasi ---
# development | testing | production
CI_ENVIRONMENT=development
# Dipakai CodeIgniter sebagai base_url; sesuaikan dengan port publish service
# `web` di docker-compose.yml (default 8887:8080).
APP_BASE_URL=http://localhost:8887/

# --- Database (service `db` / MySQL 8.4) ---
# Tiga nilai di bawah juga dipakai sebagai MYSQL_DATABASE / MYSQL_USER /
# MYSQL_PASSWORD saat container `db` pertama kali dibuat. Mengubahnya setelah
# volume `db_data` ada tidak mengubah user/database yang sudah terlanjur dibuat.
DB_DATABASE=app_ruangai
DB_USERNAME=app
DB_PASSWORD="mypass!@#"
# Password user root MySQL (hanya untuk container `db`).
DB_ROOT_PASSWORD=rootsecret

# --- PHP-FPM / Nginx (serversideup/php) ---
# Worker PHP-FPM berjalan dengan UID/GID host agar file yang ditulis aplikasi ke
# source yang di-mount (mis. public/uploads/) tetap milik user host.
# Sesuaikan dengan hasil `id -u` dan `id -g`.
PUID=1000
PGID=1000
# 0 = OPcache nonaktif (cocok untuk development), 1 = aktif (production).
PHP_OPCACHE_ENABLE=0

# --- Migrasi ---
# true  = `php spark migrate --all` dijalankan otomatis saat container start
# false = migrasi manual, mis. `docker compose exec web php spark migrate -n 'Classroom'`
RUN_MIGRATIONS=true
